  revokedAt          DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedByAdminId   String?        @map("revoked_by_admin_id") @db.Uuid
  revokedByAdmin     PlatformAdmin? @relation("VipEntitlementRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: Restrict)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("vip_salon_entitlements")
}

/// Salon VIP outreach request. Reservation, quota, and historical snapshot owner.
model VipRequest {
  id                 String            @id @db.Uuid
  salonId            String            @map("salon_id") @db.Uuid
  salon              Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  listId             String            @map("list_id") @db.Uuid
  list               VipTargetList     @relation(fields: [listId], references: [id], onDelete: Restrict)
  createdByUserId    String            @map("created_by_user_id") @db.Uuid
  createdByUser      User              @relation(fields: [createdByUserId, salonId], references: [id, salonId], onDelete: Restrict, onUpdate: Restrict)
  requestedCount     Int               @map("requested_count")
  geographicRange    String            @map("geographic_range")
  status             VipRequestStatus
  reservedUntil      DateTime          @map("reserved_until") @db.Timestamptz(3)
  submittedAt        DateTime?         @map("submitted_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  recipients         VipRequestRecipient[]
  sampleWorks        VipSampleWork[]
  sampleWorkUploads  VipSampleWorkUpload[]
  messageRequests    MessageRequest[]
  visitIntentions    VisitIntention[]

  @@unique([id, salonId])
  @@index([salonId, createdAt, id])
  @@index([salonId, status])
  @@index([listId, status])
  // Database-only partial unique index vip_requests_one_awaiting_draft_per_salon
  // (migration 20261007140000). Prisma cannot model a partial unique index.
  // A schema diff that omits it is not drift to drop: the index is the one-draft guarantee.
  // It includes only AWAITING_SAMPLE_WORK. Submitted and processing requests are unaffected.
  @@map("vip_requests")
}

/// Immutable snapshot of a selected VIP target at request time.
model VipRequestRecipient {
  id               String         @id @db.Uuid
  vipRequestId     String         @map("vip_request_id") @db.Uuid
  salonId          String         @map("salon_id") @db.Uuid
  vipRequest       VipRequest     @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  sortOrder        Int            @map("sort_order")
  sourceContactId  String         @map("source_contact_id") @db.Uuid
  sourceContact    VipTargetContact @relation(fields: [sourceContactId], references: [id], onDelete: Restrict)
  displayName      String?        @map("display_name")
  phoneNumber      String         @map("phone_number")
  messageText      String         @map("message_text")
  messageRequestId String?        @unique @map("message_request_id") @db.Uuid
  messageRequest   MessageRequest? @relation(fields: [messageRequestId, salonId], references: [id, salonId], onDelete: Restrict, onUpdate: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  visitIntentions  VisitIntention[]
  globalStopOutcome MessageGlobalStopOutcome?

  @@unique([vipRequestId, sortOrder])
  @@unique([id, salonId])
  @@unique([id, vipRequestId])
  @@index([vipRequestId, sortOrder, id])
  @@index([salonId])
  @@map("vip_request_recipients")
}

/// Sample-work image metadata. Bytes live in object storage, not this row.
model VipSampleWork {
  id          String     @id @db.Uuid
  vipRequestId String    @map("vip_request_id") @db.Uuid
  salonId     String     @map("salon_id") @db.Uuid
  vipRequest  VipRequest @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  position    Int
  objectKey   String     @map("object_key")
  contentType String     @map("content_type")
  byteSize    Int        @map("byte_size")
  sha256      String
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  upload      VipSampleWorkUpload?

  @@unique([vipRequestId, position])
  @@unique([vipRequestId, sha256])
  @@unique([objectKey])
  @@index([salonId, vipRequestId])
  @@map("vip_sample_works")
}

/// Durable intent for a cross-store VIP sample upload. Bytes remain in object storage.
model VipSampleWorkUpload {
  id             String                @id @db.Uuid
  vipRequestId   String                @map("vip_request_id") @db.Uuid
  salonId        String                @map("salon_id") @db.Uuid
  vipRequest     VipRequest            @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  sha256         String
  contentType    String                @map("content_type")
  byteSize       Int                   @map("byte_size")
  status         VipSampleUploadStatus @default(RETRYABLE)
  position       Int?
  generation     Int                   @default(0)
  objectKey      String?               @unique @map("object_key")
  ownerToken     String?               @map("owner_token")
  lockedUntil    DateTime?             @map("locked_until") @db.Timestamptz(3)
  sampleWorkId   String?               @unique @map("sample_work_id") @db.Uuid
  sampleWork     VipSampleWork?        @relation(fields: [sampleWorkId], references: [id], onDelete: Restrict)
  verifiedAt     DateTime?             @map("verified_at") @db.Timestamptz(3)
  lastErrorCode  String?               @map("last_error_code")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  cleanups       VipSampleWorkCleanup[]

  @@unique([vipRequestId, sha256])
  @@index([status, lockedUntil, id])
  @@index([vipRequestId, position])
  @@index([salonId, vipRequestId])
  @@map("vip_sample_work_uploads")
}

/// Fenced deletion of an object key owned by an obsolete, uncommitted upload generation.
model VipSampleWorkCleanup {
  id              String                 @id @db.Uuid
  uploadId        String                 @map("upload_id") @db.Uuid
  upload          VipSampleWorkUpload    @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  objectKey       String                 @unique @map("object_key")
  uploadGeneration Int                   @map("upload_generation")
  status          VipSampleCleanupStatus @default(PENDING)
  requestGeneration BigInt               @default(1) @map("request_generation")
  claimGeneration BigInt                 @default(0) @map("claim_generation")
  claimToken      String?                @map("claim_token")
  lockedUntil     DateTime?              @map("locked_until") @db.Timestamptz(3)
  availableAt     DateTime               @default(now()) @map("available_at") @db.Timestamptz(3)
  settleUntil     DateTime               @map("settle_until") @db.Timestamptz(3)
  deletePasses    Int                    @default(0) @map("delete_passes")
  attempts        Int                    @default(0)
  lastErrorCode   String?                @map("last_error_code")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt     DateTime?              @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt, lockedUntil, id])
  @@index([uploadId, uploadGeneration])
  @@map("vip_sample_work_cleanups")
}

/// Reported intention to visit. Not a ReturnCommitment, booking, Visit, Customer, or revenue.
/// CUSTOMER rows may exist without a SENT message. VIP_PROSPECT rows do not create a Customer.
/// Time precision UNKNOWN/DATE never stores a fabricated instant. DATE is a calendar date.
/// Salon reads must not join VIP target-list phone or display name.
/// Database CHECKs and partial uniques live in migration 20261010230000.
/// Extra FK visit_intentions_recipient_salon_fkey (recipient_id, salon_id) is database-only.
model VisitIntention {
  id                       String                       @id @db.Uuid
  salonId                  String                       @map("salon_id") @db.Uuid
  salon                    Salon                        @relation(fields: [salonId], references: [id], onDelete: Restrict)
  subject                  VisitIntentionSubject
  customerId               String?                      @map("customer_id") @db.Uuid
  customer                 Customer?                    @relation("VisitIntentionSubjectCustomer", fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  sourceMessageRequestId   String?                      @map("source_message_request_id") @db.Uuid
  sourceMessageRequest     MessageRequest?              @relation(fields: [sourceMessageRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  vipRequestId             String?                      @map("vip_request_id") @db.Uuid
  vipRequest               VipRequest?                  @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  vipRequestRecipientId    String?                      @map("vip_request_recipient_id") @db.Uuid
  vipRequestRecipient      VipRequestRecipient?         @relation(fields: [vipRequestRecipientId, vipRequestId], references: [id, vipRequestId], onDelete: Restrict)
  disclosedDisplayName     String?                      @map("disclosed_display_name")
  disclosedPhone           String?                      @map("disclosed_phone")
  contactBasis             VisitIntentionContactBasis   @default(WITHHELD) @map("contact_basis")
  contactRevisions         VisitIntentionContactRevision[]
  timePrecision            VisitIntentionTimePrecision  @map("time_precision")
  agreedDate               DateTime?                    @map("agreed_date") @db.Date
  agreedInstant            DateTime?                    @map("agreed_instant") @db.Timestamptz(3)
  reportChannel            VisitIntentionReportChannel  @map("report_channel")
  createdByUserId          String?                      @map("created_by_user_id") @db.Uuid
  createdByUser            User?                        @relation("VisitIntentionCreatedBy", fields: [createdByUserId, salonId], references: [id, salonId], onDelete: Restrict)
  createdByPlatformAdminId String?                      @map("created_by_platform_admin_id") @db.Uuid
  createdByPlatformAdmin   PlatformAdmin?               @relation("VisitIntentionCreatedByAdmin", fields: [createdByPlatformAdminId], references: [id], onDelete: Restrict)
  updatedByUserId          String?                      @map("updated_by_user_id") @db.Uuid
  updatedByUser            User?                        @relation("VisitIntentionUpdatedBy", fields: [updatedByUserId, salonId], references: [id, salonId], onDelete: Restrict)
  updatedByPlatformAdminId String?                      @map("updated_by_platform_admin_id") @db.Uuid
  updatedByPlatformAdmin   PlatformAdmin?               @relation("VisitIntentionUpdatedByAdmin", fields: [updatedByPlatformAdminId], references: [id], onDelete: Restrict)
  linkedVisitId            String?                      @map("linked_visit_id") @db.Uuid
  linkedVisit              Visit?                       @relation(fields: [linkedVisitId, salonId], references: [id, salonId], onDelete: Restrict)
  linkedCustomerId         String?                      @map("linked_customer_id") @db.Uuid
  linkedCustomer           Customer?                    @relation("VisitIntentionLinkedCustomer", fields: [linkedCustomerId, salonId], references: [id, salonId], onDelete: Restrict)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, salonId])
  @@index([salonId, customerId, createdAt, id])
  @@index([salonId, subject, createdAt, id])
  @@index([salonId, vipRequestId, createdAt, id])
  @@map("visit_intentions")
}

/// Each version of disclosed VIP contact details. Revision 1 is the original claim.
/// Audit logs do not copy these name or phone values.
model VisitIntentionContactRevision {
  id                        String                     @id @db.Uuid
  visitIntentionId          String                     @map("visit_intention_id") @db.Uuid
  salonId                   String                     @map("salon_id") @db.Uuid
  visitIntention            VisitIntention             @relation(fields: [visitIntentionId, salonId], references: [id, salonId], onDelete: Restrict)
  revision                  Int
  contactBasis              VisitIntentionContactBasis @map("contact_basis")
  disclosedDisplayName      String?                    @map("disclosed_display_name")
  disclosedPhone            String?                    @map("disclosed_phone")
  recordedByUserId          String?                    @map("recorded_by_user_id") @db.Uuid
  recordedByPlatformAdminId String?                    @map("recorded_by_platform_admin_id") @db.Uuid
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([visitIntentionId, revision])
  @@index([salonId, visitIntentionId, revision])
  @@map("visit_intention_contact_revisions")
}

/// Platform-wide stop for one canonical destination phone. Not consent proof.
/// One current row per phone. History is append-only in PlatformMessageStopEvent.
model PlatformMessageStop {
  id                   String    @id @db.Uuid
  phoneNumber          String    @unique @map("phone_number")
  active               Boolean
  reasonCode           String    @map("reason_code")
  registeredByAdminId  String    @map("registered_by_admin_id") @db.Uuid
  registeredByAdmin    PlatformAdmin @relation("PlatformMessageStopRegisteredBy", fields: [registeredByAdminId], references: [id], onDelete: Restrict)
  registeredAt         DateTime  @map("registered_at") @db.Timestamptz(3)
  liftedByAdminId      String?   @map("lifted_by_admin_id") @db.Uuid
  liftedByAdmin        PlatformAdmin? @relation("PlatformMessageStopLiftedBy", fields: [liftedByAdminId], references: [id], onDelete: Restrict)
  liftedAt             DateTime? @map("lifted_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  events               PlatformMessageStopEvent[]

  @@index([active, phoneNumber])
  @@map("platform_message_stops")
}

enum PlatformMessageStopAction {
  REGISTERED
  LIFTED
}

/// Immutable register/lift history. Does not store message text or free-text notes.
model PlatformMessageStopEvent {
  id            String                     @id @db.Uuid
  stopId        String                     @map("stop_id") @db.Uuid
  stop          PlatformMessageStop        @relation(fields: [stopId], references: [id], onDelete: Restrict)
  phoneNumber   String                     @map("phone_number")
  action        PlatformMessageStopAction
  reasonCode    String                     @map("reason_code")
  actorAdminId  String                     @map("actor_admin_id") @db.Uuid
  actorAdmin    PlatformAdmin              @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([stopId, createdAt])
  @@map("platform_message_stop_events")
}

/// Durable skip/block of unsent work after a global stop. Not a SENT or provider failure.
model MessageGlobalStopOutcome {
  id                    String    @id @db.Uuid
  salonId               String    @map("salon_id") @db.Uuid
  salon                 Salon     @relation(fields: [salonId], references: [id], onDelete: Restrict)
  phoneNumber           String    @map("phone_number")
  reasonCode            String    @map("reason_code")
  messageRequestId      String?   @map("message_request_id") @db.Uuid
  messageRequest        MessageRequest? @relation(fields: [messageRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  vipRequestRecipientId String?   @map("vip_request_recipient_id") @db.Uuid
  vipRequestRecipient   VipRequestRecipient? @relation(fields: [vipRequestRecipientId, salonId], references: [id, salonId], onDelete: Restrict)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([messageRequestId, salonId])
  @@unique([vipRequestRecipientId, salonId])

  @@index([salonId, createdAt])
  @@index([phoneNumber])
  @@map("message_global_stop_outcomes")
}

/// Possession challenge for a future salon-owner signup.
/// Not a User, Salon, Customer, marketing MessageRequest, or VIP send.
/// The mobile number and OTP code are not stored. One open row per phone hash.
enum SignupPhoneChallengeStatus {
  DISPATCHING
  SENT
  AMBIGUOUS
  INVALIDATED
  VERIFIED
  EXPIRED
}

enum SignupPhoneVerifyState {
  IN_PROGRESS
  REJECTED
  UNCONFIRMED
  SUCCEEDED
}

model SignupPhoneChallenge {
  id                 String                       @id @db.Uuid
  phoneHash          String                       @map("phone_hash")
  status             SignupPhoneChallengeStatus
  idempotencyKey     String                       @unique @map("idempotency_key")
  requestHash        String                       @map("request_hash")
  providerRequestId  String?                      @map("provider_request_id")
  expiresAt          DateTime                     @map("expires_at") @db.Timestamptz(3)
  verifyAttempts     Int                          @default(0) @map("verify_attempts")
  proofHash          String?                      @unique @map("proof_hash")
  proofExpiresAt     DateTime?                    @map("proof_expires_at") @db.Timestamptz(3)
  proofConsumedAt    DateTime?                    @map("proof_consumed_at") @db.Timestamptz(3)
  /// Closes the one-open-proof slot after consumption or proof expiry.
  proofClosedAt      DateTime?                    @map("proof_closed_at") @db.Timestamptz(3)
  verifiedAt         DateTime?                    @map("verified_at") @db.Timestamptz(3)
  invalidatedAt      DateTime?                    @map("invalidated_at") @db.Timestamptz(3)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  verifyAttemptsLog  SignupPhoneVerifyAttempt[]

  /// Partial unique index signup_phone_challenges_one_open_phone
  /// on phone_hash WHERE status IN (DISPATCHING, SENT, AMBIGUOUS).
  /// Partial unique index signup_phone_challenges_one_open_proof
  /// on phone_hash WHERE status = VERIFIED AND proof_closed_at IS NULL.
  @@index([phoneHash, createdAt])
  @@map("signup_phone_challenges")
}

/// One verify submission. Stores an HMAC of the request, never the code or proof.
model SignupPhoneVerifyAttempt {
  id             String                  @id @db.Uuid
  challengeId    String                  @map("challenge_id") @db.Uuid
  challenge      SignupPhoneChallenge    @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  idempotencyKey String                  @unique @map("idempotency_key")
  requestHash    String                  @map("request_hash")
  state          SignupPhoneVerifyState
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([challengeId, createdAt])
  @@map("signup_phone_verify_attempts")
}

/// Committed phone-owner signup, so a lost HTTP response can be retried by idempotency key.
/// Does not store the phone, password, signup proof, or OTP.
model PhoneOwnerCompletion {
  id             String   @id @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  requestHash    String   @map("request_hash")
  salonId        String   @unique @map("salon_id") @db.Uuid
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  userId         String   @unique @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId, salonId], references: [id, salonId], onDelete: Restrict)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  agreementAcceptances AgreementAcceptance[]

  @@unique([userId, salonId])
  @@map("phone_owner_completions")
}

/// Published agreement text. Ordinary routes cannot update or delete a row.
/// A wording change inserts a new version key. API startup does not publish one.
model AgreementVersion {
  id                 String    @id @db.Uuid
  versionKey         String    @unique @map("version_key")
  templateDigest     String    @map("template_digest") @db.Char(64)
  canonicalText      String    @map("canonical_text") @db.Text
  checkboxWording    String    @map("checkbox_wording") @db.Text
  buttonWording      String    @map("button_wording") @db.Text
  amountIrr          Decimal   @map("amount_irr") @db.Decimal(19, 2)
  scopeSnapshot      Json      @map("scope_snapshot")
  publishedAt        DateTime  @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedByAdminId String    @map("published_by_admin_id") @db.Uuid
  publishedByAdmin   PlatformAdmin @relation(fields: [publishedByAdminId], references: [id], onDelete: Restrict)
  presentations      AgreementPresentation[]
  acceptances        AgreementAcceptance[]

  @@map("agreement_versions")
}

/// Server rendering shown before acceptance. Immutable after insert.
model AgreementPresentation {
  id                         String   @id @db.Uuid
  salonId                    String   @map("salon_id") @db.Uuid
  salon                      Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  userId                     String   @map("user_id") @db.Uuid
  user                       User     @relation(fields: [userId, salonId], references: [id, salonId], onDelete: Restrict)
  versionId                  String   @map("version_id") @db.Uuid
  version                    AgreementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  renderedDigest             String   @map("rendered_digest") @db.Char(64)
  evidenceKeyId              String   @map("evidence_key_id")
  declaredFieldsCiphertext   Bytes    @map("declared_fields_ciphertext")
  declaredFieldsNonce        Bytes    @map("declared_fields_nonce")
  renderedDocumentCiphertext Bytes    @map("rendered_document_ciphertext")
  renderedDocumentNonce      Bytes    @map("rendered_document_nonce")
  expiresAt                  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  acceptance                 AgreementAcceptance?

  @@index([salonId, userId, createdAt])
  @@map("agreement_presentations")
}

/// Explicit acceptance of one presented document. Immutable. National ID and the
/// filled document live only in the encrypted snapshot.
model AgreementAcceptance {
  id                     String   @id @db.Uuid
  salonId                String   @map("salon_id") @db.Uuid
  salon                  Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  userId                 String   @map("user_id") @db.Uuid
  user                   User     @relation(fields: [userId, salonId], references: [id, salonId], onDelete: Restrict)
  versionId              String   @map("version_id") @db.Uuid
  version                AgreementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  presentationId         String   @unique @map("presentation_id") @db.Uuid
  presentation           AgreementPresentation @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  templateDigest         String   @map("template_digest") @db.Char(64)
  renderedDigest         String   @map("rendered_digest") @db.Char(64)
  snapshotDigest         String   @map("snapshot_digest") @db.Char(64)
  checkboxWording        String   @map("checkbox_wording") @db.Text
  buttonWording          String   @map("button_wording") @db.Text
  checkboxConfirmed      Boolean  @map("checkbox_confirmed")
  phoneOwnerCompletionId String?  @map("phone_owner_completion_id") @db.Uuid
  phoneOwnerCompletion   PhoneOwnerCompletion? @relation(fields: [phoneOwnerCompletionId], references: [id], onDelete: Restrict)
  acceptedAt             DateTime @map("accepted_at") @db.Timestamptz(3)
  sessionJti             String   @map("session_jti") @db.Uuid
  clientIp               String?  @map("client_ip")
  clientIpSource         String   @map("client_ip_source")
  userAgent              String?  @map("user_agent")
  appVersion             String?  @map("app_version")
  appBuild               String?  @map("app_build")
  apiRevision            String   @map("api_revision")
  requestId              String   @map("request_id")
  correlationId          String   @map("correlation_id")
  amountIrr              Decimal  @map("amount_irr") @db.Decimal(19, 2)
  scopeSnapshot          Json     @map("scope_snapshot")
  evidenceKeyId          String   @map("evidence_key_id")
  snapshotCiphertext     Bytes    @map("snapshot_ciphertext")
  snapshotNonce          Bytes    @map("snapshot_nonce")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  activationReceipts     ActivationReceipt[]

  @@index([salonId, acceptedAt])
  @@map("agreement_acceptances")
}

/// Manual card-transfer evidence. A photograph is not confirmed payment.
/// UPLOADING and FAILED are not reviewable. A STORED row stays STORED until a
/// verified replacement commits SUPERSEDED and the new STORED row together.
/// UNDER_REVIEW, APPROVED, REJECTED, and SUPERSEDED are retained.
/// APPROVED stores the platform admin's manual bank-attestation sentence.
enum ActivationReceiptPhase {
  UPLOADING
  FAILED
  STORED
  SUPERSEDED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model ActivationReceipt {
  id                       String                  @id @db.Uuid
  salonId                  String                  @map("salon_id") @db.Uuid
  salon                    Salon                   @relation(fields: [salonId], references: [id], onDelete: Restrict)
  userId                   String                  @map("user_id") @db.Uuid
  user                     User                    @relation(fields: [userId, salonId], references: [id, salonId], onDelete: Restrict)
  agreementAcceptanceId    String                  @map("agreement_acceptance_id") @db.Uuid
  agreementAcceptance      AgreementAcceptance     @relation(fields: [agreementAcceptanceId], references: [id], onDelete: Restrict)
  objectKey                String                  @map("object_key")
  contentType              String                  @map("content_type")
  byteSize                 Int                     @map("byte_size")
  sha256                   String                  @db.Char(64)
  phase                    ActivationReceiptPhase
  storedAt                 DateTime?               @map("stored_at") @db.Timestamptz(3)
  submittedAt              DateTime?               @map("submitted_at") @db.Timestamptz(3)
  submissionIdempotencyKey String?                 @map("submission_idempotency_key")
  amountIrr                Decimal?                @map("amount_irr") @db.Decimal(19, 2)
  instructionSnapshot      Json?                   @map("instruction_snapshot")
  instructionDigest        String?                 @map("instruction_digest") @db.Char(64)
  decidedAt                DateTime?               @map("decided_at") @db.Timestamptz(3)
  decidedByAdminId         String?                 @map("decided_by_admin_id") @db.Uuid
  decidedByAdmin           PlatformAdmin?          @relation(fields: [decidedByAdminId], references: [id], onDelete: Restrict)
  decisionIdempotencyKey   String?                 @map("decision_idempotency_key")
  rejectionReason          String?                 @map("rejection_reason")
  /// Exact manual attestation. Required for APPROVED and empty for every other phase.
  bankAttestationWording   String?                 @map("bank_attestation_wording") @db.Text
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([salonId, createdAt])
  @@index([phase, submittedAt])
  @@map("activation_receipts")
}
