generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  ACTIVE
  SUSPENDED
}

/// Product entitlement for a salon. Independent of SalonStatus and of VIP entitlement.
/// PRODUCT is full product access. Existing rows stay PRODUCT.
/// AWAITING_AGREEMENT is phone-owned onboarding before agreement acceptance.
/// AWAITING_PAYMENT is phone-owned onboarding after acceptance and before a later payment slice.
/// Neither onboarding state grants product routes.
enum SalonAccessState {
  PRODUCT
  AWAITING_AGREEMENT
  AWAITING_PAYMENT
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

enum OpportunityActionStatus {
  OPEN
  COMPLETED
  DISMISSED
}

enum OpportunityActionType {
  REACTIVATION
  CUSTOMER_RETURN
  REVENUE_DECLINE
}

enum MessageDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum MessageRequestStatus {
  QUEUED
  DISPATCHED
  SENT
  FAILED
  CANCELLED
}

enum MessageDeliveryMode {
  BALE
  MANUAL
}

enum MessageProvider {
  BALE_SAFIR
}

enum MessageChannel {
  TEXT
}

enum VipTargetListStatus {
  PENDING
  ACTIVE
  INACTIVE
  IN_USE
}

/// Reviewed catalog collection. Null means the list is not in that collection.
enum VipCatalogMembership {
  ORIGINAL_TEHRAN
}

enum VipRequestStatus {
  AWAITING_SAMPLE_WORK
  SUBMITTED
  MANUAL_QUEUED
  BALE_NOT_IMPLEMENTED
  CANCELLED
}

enum VipSampleUploadStatus {
  RETRYABLE
  UPLOADING
  AVAILABLE
  ABANDONED
}

enum VipSampleCleanupStatus {
  PENDING
  PROCESSING
  PROCESSED
}

/// Who the reported intention is about. Not a delivery or acquisition status.
enum VisitIntentionSubject {
  CUSTOMER
  VIP_PROSPECT
}

/// How much of an agreed time was actually reported. DATE is a calendar date, not an instant.
enum VisitIntentionTimePrecision {
  UNKNOWN
  DATE
  INSTANT
}

/// Provenance of the report. Not a workflow state.
enum VisitIntentionReportChannel {
  SALON_STAFF
  TOLD_PLATFORM_ADMIN
  INBOUND_TO_SALON
  REPORTED_DURING_MANUAL_HANDLING
}

/// Why contact details may be shown to the salon. WITHHELD is not consent.
/// Existing rows stay WITHHELD. A later correction cannot promote WITHHELD to authorized.
enum VisitIntentionContactBasis {
  WITHHELD
  SALON_SUPPLIED
  ADMIN_AUTHORIZED
}

model Salon {
  id        String      @id @db.Uuid
  name      String
  phone     String?
  address   String?
  status    SalonStatus @default(ACTIVE)
  accessState            SalonAccessState @default(PRODUCT) @map("access_state")
  /// False for a phone-owned salon, which has one owner. Existing salons stay true.
  additionalUsersAllowed Boolean          @default(true) @map("additional_users_allowed")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  users     User[]
  customers    Customer[]
  visits              Visit[]
  services            Service[]
  transactions        LedgerTransaction[]
  opportunityActions  OpportunityAction[]
  messageRequests     MessageRequest[]
  messageDeliveries   MessageDelivery[]
  vipEntitlement      VipSalonEntitlement?
  vipRequests         VipRequest[]
  reservedVipLists    VipTargetList[]      @relation("VipListReservedBySalon")
  returnCommitments   ReturnCommitment[]
  supportConversations SupportConversation[]
  visitIntentions      VisitIntention[]
  globalStopOutcomes   MessageGlobalStopOutcome[]
  phoneOwnerCompletion PhoneOwnerCompletion?
  agreementPresentations AgreementPresentation[]
  agreementAcceptances AgreementAcceptance[]
  activationReceipts ActivationReceipt[]

  @@map("salons")
}

model Customer {
  id          String   @id @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phoneNumber String   @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  visits             Visit[]
  transactions       LedgerTransaction[]
  opportunityActions OpportunityAction[]
  messageRequests    MessageRequest[]
  messageDeliveries  MessageDelivery[]
  returnCommitments  ReturnCommitment[]
  visitIntentions    VisitIntention[] @relation("VisitIntentionSubjectCustomer")
  linkedVisitIntentions VisitIntention[] @relation("VisitIntentionLinkedCustomer")

  @@unique([id, salonId])
  @@unique([salonId, phoneNumber])
  @@index([salonId, createdAt, id])
  @@map("customers")
}

/// Completed historical salon interaction. Not a booking, appointment, or reservation.
model Visit {
  id         String   @id @db.Uuid
  salonId    String   @map("salon_id") @db.Uuid
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  visitedAt  DateTime @map("visited_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactions       LedgerTransaction[]
  returnCommitments  ReturnCommitment[]
  visitIntentions    VisitIntention[]

  @@unique([id, salonId])
  @@index([salonId, visitedAt])
  @@index([salonId, customerId, visitedAt])
  @@map("visits")
}

/// Salon offering used only for revenue line items. Not a booking or inventory item.
model Service {
  id        String        @id @db.Uuid
  salonId   String        @map("salon_id") @db.Uuid
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name      String
  status    ServiceStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     TransactionItem[]

  @@unique([id, salonId])
  @@unique([salonId, name])
  @@index([salonId, status])
  @@map("services")
}

/// Financial fact. Amount is authoritative. Visit link is optional. Never cascade-deleted.
model LedgerTransaction {
  id         String            @id @db.Uuid
  salonId    String            @map("salon_id") @db.Uuid
  salon      Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId String            @map("customer_id") @db.Uuid
  customer   Customer          @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  visitId    String?           @map("visit_id") @db.Uuid
  visit      Visit?            @relation(fields: [visitId, salonId], references: [id, salonId], onDelete: Restrict)
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz(3)
  amount     Decimal           @db.Decimal(19, 2)
  currency   String            @default("IRR") @db.Char(3)
  status     TransactionStatus @default(COMPLETED)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  items      TransactionItem[]

  @@unique([id, salonId])
  @@index([salonId, occurredAt, id])
  @@index([salonId, customerId, occurredAt])
  @@index([salonId, status, occurredAt])
  @@index([salonId, visitId])
  @@map("transactions")
}

model TransactionItem {
  id            String            @id @db.Uuid
  salonId       String            @map("salon_id") @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId, salonId], references: [id, salonId], onDelete: Restrict)
  serviceId     String            @map("service_id") @db.Uuid
  service       Service           @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Restrict)
  quantity      Int
  unitPrice     Decimal           @map("unit_price") @db.Decimal(19, 2)
  totalAmount   Decimal           @map("total_amount") @db.Decimal(19, 2)

  @@index([salonId, transactionId])
  @@map("transaction_items")
}

model User {
  id           String     @id @db.Uuid
  salonId      String     @map("salon_id") @db.Uuid
  salon        Salon      @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name         String
  /// Globally unique legacy login. Null for a phone-owned owner. Exactly one of email or phone is set.
  email        String?    @unique
  /// Canonical Iranian mobile (`09` + 9 digits). Globally unique permanent login for a phone-owned owner.
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdOpportunityActions OpportunityAction[]
  createdMessageRequests    MessageRequest[]
  createdMessageDeliveries  MessageDelivery[]
  createdVipRequests        VipRequest[]
  createdReturnCommitments  ReturnCommitment[] @relation("ReturnCommitmentCreatedBy")
  updatedReturnCommitments  ReturnCommitment[] @relation("ReturnCommitmentUpdatedBy")
  createdVisitIntentions    VisitIntention[] @relation("VisitIntentionCreatedBy")
  updatedVisitIntentions    VisitIntention[] @relation("VisitIntentionUpdatedBy")
  supportConversation       SupportConversation?
  authoredSupportMessages   SupportMessage[] @relation("SupportMessageAuthorUser")
  phoneOwnerCompletion      PhoneOwnerCompletion?
  agreementPresentations    AgreementPresentation[]
  agreementAcceptances      AgreementAcceptance[]
  activationReceipts        ActivationReceipt[]

  @@unique([id, salonId])
  @@index([salonId])
  @@map("users")
}

/// Operational record that the salon responded to a derived opportunity.
/// Not a visit, transaction, campaign, or message send.
model OpportunityAction {
  id               String                   @id @db.Uuid
  salonId          String                   @map("salon_id") @db.Uuid
  salon            Salon                    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId       String                   @map("customer_id") @db.Uuid
  customer         Customer                 @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  opportunityType  OpportunityActionType    @map("opportunity_type")
  status           OpportunityActionStatus
  createdBy        String                   @map("created_by") @db.Uuid
  createdByUser    User                     @relation(fields: [createdBy, salonId], references: [id, salonId], onDelete: Restrict, onUpdate: Restrict)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt      DateTime?                @map("completed_at") @db.Timestamptz(3)
  dismissedAt      DateTime?                @map("dismissed_at") @db.Timestamptz(3)
  /// Snapshot of the customer's last visit when this Action was opened.
  /// Null when no visit existed at create time, or when a historical collision
  /// could not be reconstructed without inventing a visit. Not an FK.
  sourceVisitId    String?                  @map("source_visit_id") @db.Uuid
  messageRequests   MessageRequest[]
  messageDeliveries MessageDelivery[]

  @@unique([id, salonId])
  @@index([salonId, status, createdAt, id])
  @@index([salonId, customerId, createdAt, id])
  @@index([salonId, createdAt, id])
  @@index([salonId, customerId, opportunityType, sourceVisitId])
  @@map("opportunity_actions")
}

/// Platform operator. Not a salon User. Tokens have no tenant id.
model PlatformAdmin {
  id           String     @id @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  dispatchedDeliveries MessageDelivery[] @relation("MessageDeliveryDispatchedBy")
  fulfilledDeliveries  MessageDelivery[] @relation("MessageDeliveryFulfilledBy")
  createdVipLists      VipTargetList[]   @relation("VipListCreatedByAdmin")
  publishedAgreementVersions AgreementVersion[]
  grantedVipEntitlements VipSalonEntitlement[] @relation("VipEntitlementGrantedBy")
  revokedVipEntitlements VipSalonEntitlement[] @relation("VipEntitlementRevokedBy")
  createdReturnCommitments ReturnCommitment[] @relation("ReturnCommitmentCreatedByAdmin")
  updatedReturnCommitments ReturnCommitment[] @relation("ReturnCommitmentUpdatedByAdmin")
  createdVisitIntentions   VisitIntention[] @relation("VisitIntentionCreatedByAdmin")
  updatedVisitIntentions   VisitIntention[] @relation("VisitIntentionUpdatedByAdmin")
  supportMessages          SupportMessage[]
  registeredMessageStops   PlatformMessageStop[] @relation("PlatformMessageStopRegisteredBy")
  liftedMessageStops       PlatformMessageStop[] @relation("PlatformMessageStopLiftedBy")
  messageStopEvents        PlatformMessageStopEvent[]
  decidedActivationReceipts ActivationReceipt[]

  @@map("platform_admins")
}

/// Durable salon intent to message a recipient. Independent of Bale or any provider.
/// Salon-customer messages set customerId. VIP outreach sets vipRequestId + recipient snapshot fields.
model MessageRequest {
  id                  String                 @id @db.Uuid
  salonId             String                 @map("salon_id") @db.Uuid
  salon               Salon                  @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId          String?                @map("customer_id") @db.Uuid
  customer            Customer?              @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  actionId            String?                @map("action_id") @db.Uuid
  action              OpportunityAction?     @relation(fields: [actionId, salonId], references: [id, salonId], onDelete: Restrict)
  createdByUserId     String                 @map("created_by_user_id") @db.Uuid
  createdByUser       User                   @relation(fields: [createdByUserId, salonId], references: [id, salonId], onDelete: Restrict, onUpdate: Restrict)
  opportunityType     OpportunityActionType? @map("opportunity_type")
  vipRequestId        String?                @map("vip_request_id") @db.Uuid
  vipRequest          VipRequest?            @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  recipientDisplayName String?               @map("recipient_display_name")
  /// Immutable intended execution destination for new customer and VIP requests.
  /// Null only for historical customer rows whose original destination cannot be proven.
  recipientPhoneNumber String?               @map("recipient_phone_number")
  /// Immutable customer-facing text. PII; not written to audit metadata or logs.
  messageText         String                 @map("message_text")
  requestedAt         DateTime               @default(now()) @map("requested_at") @db.Timestamptz(3)
  /// Asia/Tehran calendar date of requestedAt. Stored instants remain timestamptz UTC.
  messageBusinessDate DateTime               @map("message_business_date") @db.Date
  /// True for salon-originated customer messages (the enforceable daily limit). False for VIP and historical backfill.
  countsTowardDailyLimit Boolean             @default(true) @map("counts_toward_daily_limit")
  status              MessageRequestStatus
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries          MessageDelivery[]
  /// Prisma requires a composite unique index to expose this composite FK as
  /// one-to-one. The existing unique message_request_id index enforces that
  /// cardinality physically, so avoid a redundant composite index here.
  vipRequestRecipients VipRequestRecipient[]
  returnCommitment    ReturnCommitment?
  visitIntentions     VisitIntention[]
  globalStopOutcomes  MessageGlobalStopOutcome[]

  @@unique([id, salonId])
  /// SQL CHECKs:
  /// `message_requests_opportunity_context_consistent`: (action_id IS NULL) = (opportunity_type IS NULL).
  /// `message_requests_recipient_origin_consistent`: salon customer XOR VIP request snapshot;
  /// customer-origin null destination is allowed only for legacy rows.
  /// SQL trigger requires canonical destination on INSERT and prevents updates thereafter.
  /// Partial unique index `message_requests_salon_customer_day_key`:
  /// UNIQUE (salon_id, customer_id, message_business_date) WHERE counts_toward_daily_limit.
  /// Partial unique index `message_requests_one_per_vip_recipient_phone`:
  /// UNIQUE (vip_request_id, recipient_phone_number) WHERE vip_request_id IS NOT NULL.
  @@index([salonId, customerId, messageBusinessDate])
  @@index([status, requestedAt, id])
  @@index([salonId, requestedAt, id])
  @@index([salonId, customerId, requestedAt, id])
  @@index([customerId, requestedAt])
  @@index([vipRequestId])
  @@map("message_requests")
}

/// How a MessageRequest is fulfilled. Bale is one mode. Not the salon intent record.
model MessageDelivery {
  id                  String                 @id @db.Uuid
  salonId             String                 @map("salon_id") @db.Uuid
  salon               Salon                  @relation(fields: [salonId], references: [id], onDelete: Restrict)
  messageRequestId    String                 @map("message_request_id") @db.Uuid
  messageRequest      MessageRequest         @relation(fields: [messageRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  customerId          String?                @map("customer_id") @db.Uuid
  customer            Customer?              @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  actionId            String?                @map("action_id") @db.Uuid
  action              OpportunityAction?     @relation(fields: [actionId, salonId], references: [id, salonId], onDelete: Restrict)
  mode                MessageDeliveryMode
  provider            MessageProvider?
  channel             MessageChannel
  status              MessageDeliveryStatus
  providerRequestId   String                 @map("provider_request_id")
  providerMessageId   String?                @map("provider_message_id")
  failureCode         String?                @map("failure_code")
  attempts            Int                    @default(0)
  /// Logical admin retry generation, carried by activation events.
  executionGeneration Int                    @default(0) @map("execution_generation")
  /// Short-lived owner for one provider execution, reclaimed only after its lease expires.
  executionToken      String?                @map("execution_token")
  executionLockedUntil DateTime?              @map("execution_locked_until") @db.Timestamptz(3)
  createdBy           String                 @map("created_by") @db.Uuid
  createdByUser       User                   @relation(fields: [createdBy, salonId], references: [id, salonId], onDelete: Restrict, onUpdate: Restrict)
  dispatchedByAdminId String?                @map("dispatched_by_admin_id") @db.Uuid
  dispatchedByAdmin   PlatformAdmin?         @relation("MessageDeliveryDispatchedBy", fields: [dispatchedByAdminId], references: [id], onDelete: Restrict)
  fulfilledByAdminId  String?                @map("fulfilled_by_admin_id") @db.Uuid
  fulfilledByAdmin    PlatformAdmin?         @relation("MessageDeliveryFulfilledBy", fields: [fulfilledByAdminId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt         DateTime?              @map("submitted_at") @db.Timestamptz(3)
  failedAt            DateTime?              @map("failed_at") @db.Timestamptz(3)
  returnCommitment    ReturnCommitment?

  @@unique([id, salonId])
  @@unique([messageRequestId])
  @@unique([salonId, providerRequestId])
  @@index([salonId, customerId, createdAt, id])
  @@index([salonId, status, createdAt])
  @@index([salonId, actionId])
  @@index([mode, status, createdAt])
  @@index([status, createdAt, id])
  @@map("message_deliveries")
}

/// Product-originated record that a customer agreed to return after SENT outreach.
/// Not an appointment, booking, reservation, calendar event, or Visit.
/// Actor is XOR: salon User XOR PlatformAdmin. CHECK constraints in SQL.
model ReturnCommitment {
  id                      String   @id @db.Uuid
  salonId                 String   @map("salon_id") @db.Uuid
  salon                   Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId              String   @map("customer_id") @db.Uuid
  customer                Customer @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  sourceMessageRequestId  String   @map("source_message_request_id") @db.Uuid
  sourceMessageRequest    MessageRequest @relation(fields: [sourceMessageRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  sourceMessageDeliveryId String   @map("source_message_delivery_id") @db.Uuid
  sourceMessageDelivery   MessageDelivery @relation(fields: [sourceMessageDeliveryId, salonId], references: [id, salonId], onDelete: Restrict)
  expectedAt              DateTime @map("expected_at") @db.Timestamptz(3)
  /// Explicit Visit linkage via arrive or link-visit only. Null while open. Not a booking.
  actualVisitId           String?  @map("actual_visit_id") @db.Uuid
  actualVisit             Visit?   @relation(fields: [actualVisitId, salonId], references: [id, salonId], onDelete: Restrict)
  createdByUserId         String?  @map("created_by_user_id") @db.Uuid
  createdByUser           User?    @relation("ReturnCommitmentCreatedBy", fields: [createdByUserId, salonId], references: [id, salonId], onDelete: Restrict)
  createdByPlatformAdminId String? @map("created_by_platform_admin_id") @db.Uuid
  createdByPlatformAdmin  PlatformAdmin? @relation("ReturnCommitmentCreatedByAdmin", fields: [createdByPlatformAdminId], references: [id], onDelete: Restrict)
  updatedByUserId         String?  @map("updated_by_user_id") @db.Uuid
  updatedByUser           User?    @relation("ReturnCommitmentUpdatedBy", fields: [updatedByUserId, salonId], references: [id, salonId], onDelete: Restrict)
  updatedByPlatformAdminId String? @map("updated_by_platform_admin_id") @db.Uuid
  updatedByPlatformAdmin  PlatformAdmin? @relation("ReturnCommitmentUpdatedByAdmin", fields: [updatedByPlatformAdminId], references: [id], onDelete: Restrict)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, salonId])
  @@unique([sourceMessageRequestId, salonId], map: "return_commitments_salon_source_request_key")
  @@unique([sourceMessageDeliveryId, salonId], map: "return_commitments_salon_source_delivery_key")
  /// Partial unique `return_commitments_salon_actual_visit_key`:
  /// UNIQUE (salon_id, actual_visit_id) WHERE actual_visit_id IS NOT NULL.
  /// Partial `return_commitments_open_salon_expected_id_idx`:
  /// (salon_id, expected_at, id) WHERE actual_visit_id IS NULL.
  @@index([salonId, customerId, expectedAt, id])
  @@index([salonId, expectedAt, id])
  @@map("return_commitments")
}

/// Reliable asynchronous business events. Payload must not include secrets or unnecessary PII.
model OutboxEvent {
  id           String       @id @db.Uuid
  tenantId     String?      @map("tenant_id") @db.Uuid
  eventType    String       @map("event_type")
  /// Optional durable dedupe key for one logical activation event.
  dedupeKey    String?      @unique(map: "outbox_events_dedupe_key_key") @map("dedupe_key")
  payload      Json
  status       OutboxStatus @default(PENDING)
  attemptCount Int          @default(0) @map("attempt_count")
  /// Monotonically changes on every claim or reclaim; post-claim writes are fenced by this value.
  claimGeneration BigInt    @default(0) @map("claim_generation")
  availableAt  DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt     DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedUntil  DateTime?    @map("locked_until") @db.Timestamptz(3)
  processedAt  DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([processedAt])
  @@map("outbox_events")
}

model AuditLog {
  id         String   @id @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  result     String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Client retry keys for selected writes. Scoped per tenant + actor + operation.
/// Does not store request bodies, phones, or secrets.
model IdempotencyRecord {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  operation    String
  key          String
  requestHash  String   @map("request_hash")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, actorId, operation, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// One in-app support thread between a salon user and Platform Admin.
/// Not a customer message, VIP request, or provider delivery.
model SupportConversation {
  id                   String   @id @db.Uuid
  salonId              String   @map("salon_id") @db.Uuid
  salon                Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  userId               String   @unique @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId, salonId], references: [id, salonId], onDelete: Restrict)
  lastMessageAt        DateTime @map("last_message_at") @db.Timestamptz(3)
  awaitingSupportReply Boolean  @map("awaiting_support_reply")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages             SupportMessage[]

  @@unique([id, salonId])
  @@unique([userId, salonId])
  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("support_conversations")
}

/// Immutable support text. Author is exactly one salon user or one Platform Admin.
model SupportMessage {
  id                    String              @id @db.Uuid
  conversationId        String              @map("conversation_id") @db.Uuid
  salonId               String              @map("salon_id") @db.Uuid
  conversation          SupportConversation @relation(fields: [conversationId, salonId], references: [id, salonId], onDelete: Restrict)
  authorUserId          String?             @map("author_user_id") @db.Uuid
  authorUser            User?               @relation("SupportMessageAuthorUser", fields: [authorUserId, salonId], references: [id, salonId], onDelete: Restrict)
  authorPlatformAdminId String?             @map("author_platform_admin_id") @db.Uuid
  authorPlatformAdmin   PlatformAdmin?      @relation(fields: [authorPlatformAdminId], references: [id], onDelete: Restrict)
  body                  String              @db.Text
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("support_messages")
}

/// Platform-admin owned VIP contact list. Not salon Customer records.
model VipTargetList {
  id                 String              @id @db.Uuid
  name               String
  status             VipTargetListStatus
  contactCount       Int                 @map("contact_count")
  /// Canonical Tehran region code (01–14). Null for historical/non-regional lists.
  regionCode         String?             @map("region_code")
  /// Membership in a reviewed catalog collection. Null means unclassified, not invalid.
  catalogMembership  VipCatalogMembership? @map("catalog_membership")
  createdByAdminId   String              @map("created_by_admin_id") @db.Uuid
  createdByAdmin     PlatformAdmin       @relation("VipListCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  reservedBySalonId  String?             @map("reserved_by_salon_id") @db.Uuid
  reservedBySalon    Salon?              @relation("VipListReservedBySalon", fields: [reservedBySalonId], references: [id], onDelete: Restrict)
  reservedAt         DateTime?           @map("reserved_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  contacts           VipTargetContact[]
  requests           VipRequest[]

  @@index([status, createdAt, id])
  @@index([catalogMembership, createdAt, id])
  @@map("vip_target_lists")
}

model VipTargetContact {
  id          String        @id @db.Uuid
  listId      String        @map("list_id") @db.Uuid
  list        VipTargetList @relation(fields: [listId], references: [id], onDelete: Restrict)
  sortOrder   Int           @map("sort_order")
  displayName String?       @map("display_name")
  phoneNumber String        @map("phone_number")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  recipientSnapshots VipRequestRecipient[]

  @@unique([listId, phoneNumber])
  @@unique([listId, sortOrder])
  @@index([listId, sortOrder, id])
  @@map("vip_target_contacts")
}

/// Explicit admin-granted VIP product access. Not payment verification.
model VipSalonEntitlement {
  id                 String         @id @db.Uuid
  salonId            String         @unique @map("salon_id") @db.Uuid
