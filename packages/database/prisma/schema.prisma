generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

model Salon {
  id        String      @id @db.Uuid
  name      String
  phone     String?
  address   String?
  status    SalonStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  users     User[]
  customers    Customer[]
  visits       Visit[]
  services     Service[]
  transactions LedgerTransaction[]

  @@map("salons")
}

model Customer {
  id          String   @id @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phoneNumber String   @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  visits       Visit[]
  transactions LedgerTransaction[]

  @@unique([id, salonId])
  @@unique([salonId, phoneNumber])
  @@index([salonId, createdAt, id])
  @@map("customers")
}

/// Completed historical salon interaction. Not a booking, appointment, or reservation.
model Visit {
  id         String   @id @db.Uuid
  salonId    String   @map("salon_id") @db.Uuid
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  visitedAt  DateTime @map("visited_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactions LedgerTransaction[]

  @@unique([id, salonId])
  @@index([salonId, visitedAt])
  @@index([salonId, customerId, visitedAt])
  @@map("visits")
}

/// Salon offering used only for revenue line items. Not a booking or inventory item.
model Service {
  id        String        @id @db.Uuid
  salonId   String        @map("salon_id") @db.Uuid
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name      String
  status    ServiceStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     TransactionItem[]

  @@unique([id, salonId])
  @@unique([salonId, name])
  @@index([salonId, status])
  @@map("services")
}

/// Financial fact. Amount is authoritative. Visit link is optional. Never cascade-deleted.
model LedgerTransaction {
  id         String            @id @db.Uuid
  salonId    String            @map("salon_id") @db.Uuid
  salon      Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId String            @map("customer_id") @db.Uuid
  customer   Customer          @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  visitId    String?           @map("visit_id") @db.Uuid
  visit      Visit?            @relation(fields: [visitId, salonId], references: [id, salonId], onDelete: Restrict)
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz(3)
  amount     Decimal           @db.Decimal(19, 2)
  currency   String            @default("IRR") @db.Char(3)
  status     TransactionStatus @default(COMPLETED)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  items      TransactionItem[]

  @@unique([id, salonId])
  @@index([salonId, occurredAt, id])
  @@index([salonId, customerId, occurredAt])
  @@index([salonId, status, occurredAt])
  @@index([salonId, visitId])
  @@map("transactions")
}

model TransactionItem {
  id            String            @id @db.Uuid
  salonId       String            @map("salon_id") @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId, salonId], references: [id, salonId], onDelete: Restrict)
  serviceId     String            @map("service_id") @db.Uuid
  service       Service           @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Restrict)
  quantity      Int
  unitPrice     Decimal           @map("unit_price") @db.Decimal(19, 2)
  totalAmount   Decimal           @map("total_amount") @db.Decimal(19, 2)

  @@index([salonId, transactionId])
  @@map("transaction_items")
}

model User {
  id           String     @id @db.Uuid
  salonId      String     @map("salon_id") @db.Uuid
  salon        Salon      @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([salonId])
  @@map("users")
}

/// Reliable asynchronous business events. Payload must not include secrets or unnecessary PII.
model OutboxEvent {
  id           String       @id @db.Uuid
  tenantId     String?      @map("tenant_id") @db.Uuid
  eventType    String       @map("event_type")
  payload      Json
  status       OutboxStatus @default(PENDING)
  attemptCount Int          @default(0) @map("attempt_count")
  availableAt  DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt     DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedUntil  DateTime?    @map("locked_until") @db.Timestamptz(3)
  processedAt  DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([processedAt])
  @@map("outbox_events")
}

model AuditLog {
  id         String   @id @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  result     String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Client retry keys for selected writes. Scoped per tenant + actor + operation.
/// Does not store request bodies, phones, or secrets.
model IdempotencyRecord {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  operation    String
  key          String
  requestHash  String   @map("request_hash")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, actorId, operation, key])
  @@index([createdAt])
  @@map("idempotency_records")
}
