generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

enum OpportunityActionStatus {
  OPEN
  COMPLETED
  DISMISSED
}

enum OpportunityActionType {
  REACTIVATION
  CUSTOMER_RETURN
  REVENUE_DECLINE
}

enum MessageDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum MessageRequestStatus {
  QUEUED
  DISPATCHED
  SENT
  FAILED
}

enum MessageDeliveryMode {
  BALE
  MANUAL
}

enum MessageProvider {
  BALE_SAFIR
}

enum MessageChannel {
  TEXT
}

enum VipTargetListStatus {
  PENDING
  ACTIVE
  INACTIVE
  IN_USE
}

enum VipRequestStatus {
  AWAITING_SAMPLE_WORK
  SUBMITTED
  MANUAL_QUEUED
  BALE_NOT_IMPLEMENTED
  CANCELLED
}

model Salon {
  id        String      @id @db.Uuid
  name      String
  phone     String?
  address   String?
  status    SalonStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  users     User[]
  customers    Customer[]
  visits              Visit[]
  services            Service[]
  transactions        LedgerTransaction[]
  opportunityActions  OpportunityAction[]
  messageRequests     MessageRequest[]
  messageDeliveries   MessageDelivery[]
  vipEntitlement      VipSalonEntitlement?
  vipRequests         VipRequest[]
  reservedVipLists    VipTargetList[]      @relation("VipListReservedBySalon")

  @@map("salons")
}

model Customer {
  id          String   @id @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phoneNumber String   @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  visits             Visit[]
  transactions       LedgerTransaction[]
  opportunityActions OpportunityAction[]
  messageRequests    MessageRequest[]
  messageDeliveries  MessageDelivery[]

  @@unique([id, salonId])
  @@unique([salonId, phoneNumber])
  @@index([salonId, createdAt, id])
  @@map("customers")
}

/// Completed historical salon interaction. Not a booking, appointment, or reservation.
model Visit {
  id         String   @id @db.Uuid
  salonId    String   @map("salon_id") @db.Uuid
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  visitedAt  DateTime @map("visited_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactions LedgerTransaction[]

  @@unique([id, salonId])
  @@index([salonId, visitedAt])
  @@index([salonId, customerId, visitedAt])
  @@map("visits")
}

/// Salon offering used only for revenue line items. Not a booking or inventory item.
model Service {
  id        String        @id @db.Uuid
  salonId   String        @map("salon_id") @db.Uuid
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name      String
  status    ServiceStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     TransactionItem[]

  @@unique([id, salonId])
  @@unique([salonId, name])
  @@index([salonId, status])
  @@map("services")
}

/// Financial fact. Amount is authoritative. Visit link is optional. Never cascade-deleted.
model LedgerTransaction {
  id         String            @id @db.Uuid
  salonId    String            @map("salon_id") @db.Uuid
  salon      Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId String            @map("customer_id") @db.Uuid
  customer   Customer          @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  visitId    String?           @map("visit_id") @db.Uuid
  visit      Visit?            @relation(fields: [visitId, salonId], references: [id, salonId], onDelete: Restrict)
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz(3)
  amount     Decimal           @db.Decimal(19, 2)
  currency   String            @default("IRR") @db.Char(3)
  status     TransactionStatus @default(COMPLETED)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  items      TransactionItem[]

  @@unique([id, salonId])
  @@index([salonId, occurredAt, id])
  @@index([salonId, customerId, occurredAt])
  @@index([salonId, status, occurredAt])
  @@index([salonId, visitId])
  @@map("transactions")
}

model TransactionItem {
  id            String            @id @db.Uuid
  salonId       String            @map("salon_id") @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId, salonId], references: [id, salonId], onDelete: Restrict)
  serviceId     String            @map("service_id") @db.Uuid
  service       Service           @relation(fields: [serviceId, salonId], references: [id, salonId], onDelete: Restrict)
  quantity      Int
  unitPrice     Decimal           @map("unit_price") @db.Decimal(19, 2)
  totalAmount   Decimal           @map("total_amount") @db.Decimal(19, 2)

  @@index([salonId, transactionId])
  @@map("transaction_items")
}

model User {
  id           String     @id @db.Uuid
  salonId      String     @map("salon_id") @db.Uuid
  salon        Salon      @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdOpportunityActions OpportunityAction[]
  createdMessageRequests    MessageRequest[]
  createdMessageDeliveries  MessageDelivery[]
  createdVipRequests        VipRequest[]

  @@index([salonId])
  @@map("users")
}

/// Operational record that the salon responded to a derived opportunity.
/// Not a visit, transaction, campaign, or message send.
model OpportunityAction {
  id               String                   @id @db.Uuid
  salonId          String                   @map("salon_id") @db.Uuid
  salon            Salon                    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId       String                   @map("customer_id") @db.Uuid
  customer         Customer                 @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  opportunityType  OpportunityActionType    @map("opportunity_type")
  status           OpportunityActionStatus
  createdBy        String                   @map("created_by") @db.Uuid
  createdByUser    User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt      DateTime?                @map("completed_at") @db.Timestamptz(3)
  dismissedAt      DateTime?                @map("dismissed_at") @db.Timestamptz(3)
  /// Snapshot of the customer's last visit when this Action was opened.
  /// Null when no visit existed at create time, or when a historical collision
  /// could not be reconstructed without inventing a visit. Not an FK.
  sourceVisitId    String?                  @map("source_visit_id") @db.Uuid
  messageRequests   MessageRequest[]
  messageDeliveries MessageDelivery[]

  @@unique([id, salonId])
  @@index([salonId, status, createdAt, id])
  @@index([salonId, customerId, createdAt, id])
  @@index([salonId, createdAt, id])
  @@index([salonId, customerId, opportunityType, sourceVisitId])
  @@map("opportunity_actions")
}

/// Platform operator. Not a salon User. Tokens have no tenant id.
model PlatformAdmin {
  id           String     @id @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  dispatchedDeliveries MessageDelivery[] @relation("MessageDeliveryDispatchedBy")
  fulfilledDeliveries  MessageDelivery[] @relation("MessageDeliveryFulfilledBy")
  createdVipLists      VipTargetList[]   @relation("VipListCreatedByAdmin")
  grantedVipEntitlements VipSalonEntitlement[] @relation("VipEntitlementGrantedBy")
  revokedVipEntitlements VipSalonEntitlement[] @relation("VipEntitlementRevokedBy")

  @@map("platform_admins")
}

/// Durable salon intent to message a recipient. Independent of Bale or any provider.
/// Salon-customer messages set customerId. VIP outreach sets vipRequestId + recipient snapshot fields.
model MessageRequest {
  id                  String                 @id @db.Uuid
  salonId             String                 @map("salon_id") @db.Uuid
  salon               Salon                  @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerId          String?                @map("customer_id") @db.Uuid
  customer            Customer?              @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  actionId            String?                @map("action_id") @db.Uuid
  action              OpportunityAction?     @relation(fields: [actionId, salonId], references: [id, salonId], onDelete: Restrict)
  createdByUserId     String                 @map("created_by_user_id") @db.Uuid
  createdByUser       User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  opportunityType     OpportunityActionType? @map("opportunity_type")
  vipRequestId        String?                @map("vip_request_id") @db.Uuid
  vipRequest          VipRequest?            @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  /// Snapshot used when customerId is null (VIP). Not a Customer record.
  recipientDisplayName String?               @map("recipient_display_name")
  recipientPhoneNumber String?               @map("recipient_phone_number")
  /// Immutable customer-facing text. PII; not written to audit metadata or logs.
  messageText         String                 @map("message_text")
  requestedAt         DateTime               @default(now()) @map("requested_at") @db.Timestamptz(3)
  /// Asia/Tehran calendar date of requestedAt. Stored instants remain timestamptz UTC.
  messageBusinessDate DateTime               @map("message_business_date") @db.Date
  /// True for salon-originated customer messages (the enforceable daily limit). False for VIP and historical backfill.
  countsTowardDailyLimit Boolean             @default(true) @map("counts_toward_daily_limit")
  status              MessageRequestStatus
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries          MessageDelivery[]
  vipRequestRecipient VipRequestRecipient?

  @@unique([id, salonId])
  /// SQL CHECKs:
  /// `message_requests_opportunity_context_consistent`: (action_id IS NULL) = (opportunity_type IS NULL).
  /// `message_requests_recipient_origin_consistent`: salon customer XOR VIP request snapshot.
  /// Partial unique index `message_requests_salon_customer_day_key`:
  /// UNIQUE (salon_id, customer_id, message_business_date) WHERE counts_toward_daily_limit.
  /// Partial unique index `message_requests_one_per_vip_recipient_phone`:
  /// UNIQUE (vip_request_id, recipient_phone_number) WHERE vip_request_id IS NOT NULL.
  @@index([salonId, customerId, messageBusinessDate])
  @@index([status, requestedAt, id])
  @@index([salonId, requestedAt, id])
  @@index([salonId, customerId, requestedAt, id])
  @@index([customerId, requestedAt])
  @@index([vipRequestId])
  @@map("message_requests")
}

/// How a MessageRequest is fulfilled. Bale is one mode. Not the salon intent record.
model MessageDelivery {
  id                  String                 @id @db.Uuid
  salonId             String                 @map("salon_id") @db.Uuid
  salon               Salon                  @relation(fields: [salonId], references: [id], onDelete: Restrict)
  messageRequestId    String                 @map("message_request_id") @db.Uuid
  messageRequest      MessageRequest         @relation(fields: [messageRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  customerId          String?                @map("customer_id") @db.Uuid
  customer            Customer?              @relation(fields: [customerId, salonId], references: [id, salonId], onDelete: Restrict)
  actionId            String?                @map("action_id") @db.Uuid
  action              OpportunityAction?     @relation(fields: [actionId, salonId], references: [id, salonId], onDelete: Restrict)
  mode                MessageDeliveryMode
  provider            MessageProvider?
  channel             MessageChannel
  status              MessageDeliveryStatus
  providerRequestId   String                 @map("provider_request_id")
  providerMessageId   String?                @map("provider_message_id")
  failureCode         String?                @map("failure_code")
  attempts            Int                    @default(0)
  createdBy           String                 @map("created_by") @db.Uuid
  createdByUser       User                   @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  dispatchedByAdminId String?                @map("dispatched_by_admin_id") @db.Uuid
  dispatchedByAdmin   PlatformAdmin?         @relation("MessageDeliveryDispatchedBy", fields: [dispatchedByAdminId], references: [id], onDelete: Restrict)
  fulfilledByAdminId  String?                @map("fulfilled_by_admin_id") @db.Uuid
  fulfilledByAdmin    PlatformAdmin?         @relation("MessageDeliveryFulfilledBy", fields: [fulfilledByAdminId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt         DateTime?              @map("submitted_at") @db.Timestamptz(3)
  failedAt            DateTime?              @map("failed_at") @db.Timestamptz(3)

  @@unique([id, salonId])
  @@unique([messageRequestId])
  @@unique([salonId, providerRequestId])
  @@index([salonId, customerId, createdAt, id])
  @@index([salonId, status, createdAt])
  @@index([salonId, actionId])
  @@index([mode, status, createdAt])
  @@index([status, createdAt, id])
  @@map("message_deliveries")
}

/// Reliable asynchronous business events. Payload must not include secrets or unnecessary PII.
model OutboxEvent {
  id           String       @id @db.Uuid
  tenantId     String?      @map("tenant_id") @db.Uuid
  eventType    String       @map("event_type")
  payload      Json
  status       OutboxStatus @default(PENDING)
  attemptCount Int          @default(0) @map("attempt_count")
  availableAt  DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt     DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedUntil  DateTime?    @map("locked_until") @db.Timestamptz(3)
  processedAt  DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([processedAt])
  @@map("outbox_events")
}

model AuditLog {
  id         String   @id @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  result     String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Client retry keys for selected writes. Scoped per tenant + actor + operation.
/// Does not store request bodies, phones, or secrets.
model IdempotencyRecord {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  operation    String
  key          String
  requestHash  String   @map("request_hash")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, actorId, operation, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// Platform-admin owned VIP contact list. Not salon Customer records.
model VipTargetList {
  id                 String              @id @db.Uuid
  name               String
  status             VipTargetListStatus
  contactCount       Int                 @map("contact_count")
  createdByAdminId   String              @map("created_by_admin_id") @db.Uuid
  createdByAdmin     PlatformAdmin       @relation("VipListCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  reservedBySalonId  String?             @map("reserved_by_salon_id") @db.Uuid
  reservedBySalon    Salon?              @relation("VipListReservedBySalon", fields: [reservedBySalonId], references: [id], onDelete: Restrict)
  reservedAt         DateTime?           @map("reserved_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  contacts           VipTargetContact[]
  requests           VipRequest[]

  @@index([status, createdAt, id])
  @@map("vip_target_lists")
}

model VipTargetContact {
  id          String        @id @db.Uuid
  listId      String        @map("list_id") @db.Uuid
  list        VipTargetList @relation(fields: [listId], references: [id], onDelete: Restrict)
  sortOrder   Int           @map("sort_order")
  displayName String        @map("display_name")
  phoneNumber String        @map("phone_number")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  recipientSnapshots VipRequestRecipient[]

  @@unique([listId, phoneNumber])
  @@unique([listId, sortOrder])
  @@index([listId, sortOrder, id])
  @@map("vip_target_contacts")
}

/// Explicit admin-granted VIP product access. Not payment verification.
model VipSalonEntitlement {
  id                 String         @id @db.Uuid
  salonId            String         @unique @map("salon_id") @db.Uuid
  salon              Salon          @relation(fields: [salonId], references: [id], onDelete: Restrict)
  grantedByAdminId   String         @map("granted_by_admin_id") @db.Uuid
  grantedByAdmin     PlatformAdmin  @relation("VipEntitlementGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: Restrict)
  grantedAt          DateTime       @map("granted_at") @db.Timestamptz(3)
  revokedAt          DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedByAdminId   String?        @map("revoked_by_admin_id") @db.Uuid
  revokedByAdmin     PlatformAdmin? @relation("VipEntitlementRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: Restrict)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("vip_salon_entitlements")
}

/// Salon VIP outreach request. Reservation, quota, and historical snapshot owner.
model VipRequest {
  id                 String            @id @db.Uuid
  salonId            String            @map("salon_id") @db.Uuid
  salon              Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  listId             String            @map("list_id") @db.Uuid
  list               VipTargetList     @relation(fields: [listId], references: [id], onDelete: Restrict)
  createdByUserId    String            @map("created_by_user_id") @db.Uuid
  createdByUser      User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  requestedCount     Int               @map("requested_count")
  geographicRange    String            @map("geographic_range")
  status             VipRequestStatus
  reservedUntil      DateTime          @map("reserved_until") @db.Timestamptz(3)
  submittedAt        DateTime?         @map("submitted_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  recipients         VipRequestRecipient[]
  sampleWorks        VipSampleWork[]
  messageRequests    MessageRequest[]

  @@unique([id, salonId])
  @@index([salonId, createdAt, id])
  @@index([salonId, status])
  @@index([listId, status])
  @@map("vip_requests")
}

/// Immutable snapshot of a selected VIP target at request time.
model VipRequestRecipient {
  id               String         @id @db.Uuid
  vipRequestId     String         @map("vip_request_id") @db.Uuid
  salonId          String         @map("salon_id") @db.Uuid
  vipRequest       VipRequest     @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  sortOrder        Int            @map("sort_order")
  sourceContactId  String         @map("source_contact_id") @db.Uuid
  sourceContact    VipTargetContact @relation(fields: [sourceContactId], references: [id], onDelete: Restrict)
  displayName      String         @map("display_name")
  phoneNumber      String         @map("phone_number")
  messageText      String         @map("message_text")
  messageRequestId String?        @unique @map("message_request_id") @db.Uuid
  messageRequest   MessageRequest? @relation(fields: [messageRequestId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([vipRequestId, sortOrder])
  @@index([vipRequestId, sortOrder, id])
  @@index([salonId])
  @@map("vip_request_recipients")
}

/// Sample-work image metadata. Bytes live in object storage, not this row.
model VipSampleWork {
  id          String     @id @db.Uuid
  vipRequestId String    @map("vip_request_id") @db.Uuid
  salonId     String     @map("salon_id") @db.Uuid
  vipRequest  VipRequest @relation(fields: [vipRequestId, salonId], references: [id, salonId], onDelete: Restrict)
  position    Int
  objectKey   String     @map("object_key")
  contentType String     @map("content_type")
  byteSize    Int        @map("byte_size")
  sha256      String
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([vipRequestId, position])
  @@unique([vipRequestId, sha256])
  @@unique([objectKey])
  @@index([salonId, vipRequestId])
  @@map("vip_sample_works")
}
