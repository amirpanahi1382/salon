NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://salon:salon@localhost:5432/salon?schema=public

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=salon-platform
MINIO_REQUEST_TIMEOUT_MS=10000

# Must be at least 32 characters. Never commit a production secret.
JWT_SECRET=change-me-in-development-only-min-32-chars
JWT_EXPIRES_IN=8h

# Server-side OTPy integration. Set a newly generated project key only in a private API environment.
# OTPY_API_KEY=
# OTPY_BASE_URL=https://api.otpy.ir
# OTPY_TIMEOUT_MS=10000

# Phone-possession signup challenge. Disabled until rollout is approved.
# It does not create a salon, user, password, or session.
# PHONE_SIGNUP_ENABLED=false
# PHONE_SIGNUP_HASH_SECRET=
# Resend cooldown, sends per phone in the window, verify attempts, local TTL cap, proof lifetime.
# The stored OTP deadline is the earlier of this cap and OTPy's reported TTL.
# PHONE_SIGNUP_RESEND_COOLDOWN_SECONDS=60
# PHONE_SIGNUP_MAX_SENDS=3
# PHONE_SIGNUP_SEND_WINDOW_SECONDS=900
# PHONE_SIGNUP_MAX_VERIFY_ATTEMPTS=5
# PHONE_SIGNUP_MAX_TTL_SECONDS=180
# PHONE_SIGNUP_PROOF_TTL_SECONDS=600

OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_MS=500
OUTBOX_BACKOFF_CAP_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
VIP_UPLOAD_LEASE_MS=30000
VIP_UPLOAD_RECOVERY_INTERVAL_MS=30000
VIP_UPLOAD_RECOVERY_BATCH_SIZE=50
VIP_UPLOAD_CLEANUP_SETTLE_MS=3600000

# Per-process Prisma pool. Unset = Prisma default. API and worker each open their own pool.
# DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT_SECONDS=10

API_SHUTDOWN_GRACE_MS=15000
HTTP_TIMEOUT_MS=5000
HEALTH_CHECK_TIMEOUT_MS=2000

# Unset: enabled when NODE_ENV is not production.
# SWAGGER_ENABLED=false

# Platform-level Bale Safir credentials (organization API access key + bot id).
# Not per-salon. Leave unset to disable outbound messaging.
# BALE_SAFIR_API_ACCESS_KEY=
# BALE_SAFIR_BOT_ID=
# BALE_SAFIR_BASE_URL=https://safir.bale.ai/api/v3
# BALE_SAFIR_TIMEOUT_MS=10000

# Development-only platform admin (both required when enabling). Never commit real values.
# Do not set these in production. Create/update with: pnpm db:bootstrap-admin
# PLATFORM_ADMIN_EMAIL=admin@salon.local
# PLATFORM_ADMIN_PASSWORD=
